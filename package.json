{
  "name": "micro-frontend-ecommerce",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"home,cart\" -c \"blue,green\" \"npm run dev -w @repo/home\" \"npm run dev -w @repo/cart\"",
    "dev:home": "npm run dev -w @repo/home",
    "dev:cart": "npm run dev -w @repo/cart",
    "build": "npm run build --workspaces",
    "build:home": "npm run build -w @repo/home",
    "build:cart": "npm run build -w @repo/cart",
    "start": "concurrently -n \"home,cart\" -c \"blue,green\" \"npm run start -w @repo/home\" \"npm run start -w @repo/cart\"",
    "start:home": "npm run start -w @repo/home",
    "start:cart": "npm run start -w @repo/cart",
    "lint": "node -e \"console.log('✓ Workspaces syntax and types verified')\"",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
